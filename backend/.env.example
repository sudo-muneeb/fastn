# Required in production
FASTN_API_KEY=change-me-fastn
MOCK_API_KEY=change-me-mock

# Optional
PORT=3000
CORS_ORIGIN=*                 # e.g. https://your-frontend.up.railway.app
DATA_FILE=/data/db.json       # persist to a Railway volume; omit for in-memory
MOCK_UNIQUE=true              # mock APIs only return comments not served before
